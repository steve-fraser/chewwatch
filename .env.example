# Copy to .env and fill in. Never commit the real values.
# Referenced from config.example.yaml via ${VAR} substitution.

# UniFi Protect Integration API key (Settings → Integrations)
PROTECT_API_KEY=

# Kimchi Inference API key (https://app.kimchi.dev/settings)
KIMCHI_API_KEY=

# ntfy topic — pick a long random string, e.g. `openssl rand -hex 16`
NTFY_TOPIC=

# ntfy access token — optional, only if your server requires auth.
# Leave empty to skip (a bare ${NTFY_TOKEN} resolves to "").
NTFY_TOKEN=
